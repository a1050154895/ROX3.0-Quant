# ==========================================
# ROX Quant 3.0 环境配置文件
# ==========================================

# 数据提供商配置
# AllTick 实时行情数据令牌 (在 https://alltick.co 获取)
ALLTICK_TOKEN=your_alltick_token_here

# AI 模型配置
# LLM 服务的 API 密钥 (例如 OpenAI, DeepSeek, SiliconFlow)
AI_API_KEY=your_ai_api_key_here
AI_BASE_URL=https://api.openai.com/v1
AI_DEFAULT_MODEL=gpt-4o

# TradingAgents-CN 集成（可选）
TRADING_AGENTS_ENABLED=false
TRADING_AGENTS_BASE_URL=http://127.0.0.1:9000
TRADING_AGENTS_ENDPOINT=/analyze
TRADING_AGENTS_API_KEY=
TRADING_AGENTS_TIMEOUT=30
TRADING_AGENTS_RETRY_COUNT=2
TRADING_AGENTS_RETRY_BACKOFF=0.5
TRADING_AGENTS_FALLBACK_LOCAL=true

# 调试开关（默认关闭）
VERBOSE_ROUTE_LOGGING=false

# 可选: 自定义 AI 提供商
# AI_PROVIDERS={"deepseek": {"base_url": "...", "api_key": "..."}}

# 数据库配置
# 数据库路径
DATABASE_URL=sqlite:///./rox.db

# 服务器配置
# 服务器主机
SERVER_HOST=127.0.0.1
# 服务器端口
SERVER_PORT=8081
# 是否启用调试模式
DEBUG=False

# 安全配置
# 用于 JWT 令牌的密钥
SECRET_KEY=your_secret_key_here
# 算法
ALGORITHM=HS256
# 访问令牌过期时间 (分钟)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 缓存配置
# Redis 连接 URL (如果使用 Redis 作为缓存)
REDIS_URL=redis://localhost:6379/0

# 数据缓存配置
# 行情数据缓存过期时间 (秒)
SPOT_CACHE_TTL=45
# 最大缓存行数
SPOT_CACHE_MAX_ROWS=3000

# 日志配置
# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# 回测配置
# 回测数据目录
BACKTEST_DATA_DIR=data/market_data

# 知识库配置
# 知识库数据目录
KNOWLEDGE_BASE_DIR=app/data/documents

# 策略配置
# 策略数据目录
STRATEGY_DIR=app/rox_quant/strategies

# 代理配置
# HTTP 代理 (可选)
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS 代理 (可选)
# HTTPS_PROXY=http://proxy.example.com:8080

# 性能配置
# 数据库连接池大小
DB_POOL_SIZE=10
# 数据库连接超时 (秒)
DB_TIMEOUT=60

# 风险控制配置
# 最大持仓比例
MAX_POSITION_PCT=0.3
# 最大单笔交易金额
MAX_TRADE_AMOUNT=100000

# 通知配置
# 通知邮箱
# NOTIFICATION_EMAIL=your_email@example.com

# 部署环境
# 环境: development, production
ENVIRONMENT=development

# ==========================================
# 配置说明
# ==========================================
# 1. 必要配置项:
#    - ALLTICK_TOKEN: 实时行情数据令牌
#    - AI_API_KEY: AI 模型 API 密钥
#    - SECRET_KEY: JWT 令牌密钥
#
# 2. 可选配置项:
#    - 其他配置项可以使用默认值
#
# 3. 如何获取配置值:
#    - ALLTICK_TOKEN: 在 https://alltick.co 注册并获取
#    - AI_API_KEY: 在相应的 AI 服务提供商处注册并获取
#    - SECRET_KEY: 可以使用随机生成的字符串
#
# 4. 生成 SECRET_KEY 的方法:
#    在终端运行: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ==========================================
